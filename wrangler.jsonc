{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streambox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./streambox-client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
